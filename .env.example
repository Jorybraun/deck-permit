# Optional server-side AI design team. The API key is never exposed to Vite or the browser.
OPENAI_API_KEY=sk-your-server-api-key
OPENAI_DESIGN_MODEL=gpt-5.6-sol
OPENAI_REVIEW_MODEL=gpt-5.6-sol

# Optional owner-authorized permit delivery. Both are required; without them the UI stays download-only.
RESEND_API_KEY=re_your_server_api_key
PERMIT_SUBMISSION_FROM_EMAIL=permits@your-verified-domain.example

# Optional server-side receipt and professional-review exchange storage.
DECK_PERMIT_DATA_DIR=./.deck-permit-data
